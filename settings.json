{
  // 📝 --- SALVAMENTO AUTOMÁTICO ---
  "files.autoSave": "afterDelay", // Salva arquivos automaticamente após um pequeno tempo de inatividade
  "files.autoSaveDelay": 3000, // Tempo de espera (em ms) antes de salvar automaticamente - AUMENTADO para evitar conflitos

  // 🎨 --- FORMATAÇÃO ---
  "editor.formatOnSave": true, // Formata o código ao salvar
  "editor.formatOnPaste": true, // Formata automaticamente ao colar
  "editor.defaultFormatter": "esbenp.prettier-vscode", // Usa o Prettier como formatador padrão

  // Formatadores específicos por linguagem
  "[python]": { "editor.defaultFormatter": "ms-python.black-formatter" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // 🪄 --- INTERFACE E EDITOR ---
  "workbench.startupEditor": "newUntitledFile", // Abre um novo arquivo em branco ao iniciar
  "editor.fontSize": 13, // Tamanho da fonte no editor
  "editor.lineHeight": 1.8, // Altura da linha (espaçamento vertical)
  "editor.tabSize": 2, // Tamanho da tabulação
  "editor.fontFamily": "JetBrains Mono", // Fonte usada no editor
  "editor.renderLineHighlight": "gutter", // Destaca a linha atual na margem esquerda
  "editor.parameterHints.enabled": false, // Desativa dicas de parâmetros flutuantes
  "editor.stickyScroll.enabled": false, // Desativa cabeçalhos fixos durante rolagem
  "editor.minimap.enabled": false, // Oculta o mapa de código lateral
  "editor.semanticHighlighting.enabled": false, // Desativa cores semânticas adicionais
  "editor.accessibilitySupport": "off", // Desativa recursos de acessibilidade
  "editor.hideCursorInOverviewRuler": false, // Oculta o cursor na régua lateral
  "editor.suggestSelection": "first", // Seleciona a primeira sugestão automaticamente
  "editor.acceptSuggestionOnCommitCharacter": false, // Impede aceitar sugestões com caracteres como ponto e vírgula
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }, // Corrige problemas do ESLint ao salvar

  // 📁 --- EXPLORADOR DE ARQUIVOS ---
  "explorer.compactFolders": false, // Exibe cada pasta em sua própria linha (sem agrupamento)
  "explorer.confirmDelete": false, // Desativa confirmação ao excluir
  "explorer.confirmDragAndDrop": false, // Desativa confirmação ao arrastar arquivos
  "explorer.sortOrder": "foldersNestsFiles", // Ordena pastas antes dos arquivos
  "explorer.fileNesting.enabled": true, // Ativa agrupamento de arquivos relacionados
  "explorer.fileNesting.patterns": {
    "package.json": ".eslint*, prettier*, tsconfig*, vite*, pnpm-*, bun.lockb, nest*, package-lock*",
    "tailwind.config.*": "tailwind.config*, postcss.config*",
    ".env.local": ".env*",
    ".env": ".env*"
  },

  // 🌈 --- ASSOCIAÇÕES DE ARQUIVOS ---
  "files.associations": {
    ".env.*": "dotenv",
    ".prettierrc": "json",
    "*.css": "css",
    ".dev.vars": "dotenv"
  },

  // 🔄 --- GIT E GITLENS ---
  "git.enableSmartCommit": true, // DESABILITADO - causava problemas de conexão
  "git.openRepositoryInParentFolders": "never", // ALTERADO - evita perder conexão com repositórios
  "git.autoRepositoryDetection": true, // Detecta repositórios automaticamente
  "git.autofetch": false, // DESABILITADO - evita conflitos
  "git.confirmSync": false, // Pede confirmação antes de sincronizar
  "gitlens.codeLens.recentChange.enabled": false, // Desativa exibição de quem alterou o código
  "gitlens.codeLens.authors.enabled": false, // Desativa exibição de autores do código

  // 🧠 --- JAVASCRIPT / TYPESCRIPT ---
  "javascript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "eslint.validate": ["javascript", "javascriptreact", "graphql"],

  // 💄 --- TEMA E APARÊNCIA ---
  "workbench.iconTheme": "material-icon-theme", // Ícones minimalistas estilo macOS
  "workbench.productIconTheme": "fluent-icons", // Ícones gerais do VS Code
  "workbench.colorTheme": "Dracula Theme", // Tema escuro Dracula
  "workbench.statusBar.visible": true, // Mostra a barra de status
  "workbench.layoutControl.enabled": false, // Oculta botão de layout
  "workbench.editor.labelFormat": "short", // Mostra nomes curtos de abas
  "workbench.editor.empty.hint": "hidden", // Oculta a dica quando o editor está vazio
  "window.titleBarStyle": "native", // Usa barra de título do macOS

  // 💻 --- TERMINAL ---
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font", // Fonte do terminal
  "terminal.integrated.fontSize": 14, // Tamanho da fonte do terminal
  "terminal.integrated.showExitAlert": false, // Remove alerta ao sair
  "terminal.integrated.gpuAcceleration": "on", // Usa aceleração por GPU

  // ⚡ --- EMMET ---
  "emmet.includeLanguages": { "javascript": "javascriptreact" },
  "emmet.syntaxProfiles": { "javascript": "jsx" },

  // 🔒 --- SEGURANÇA E ATUALIZAÇÕES ---
  "security.workspace.trust.untrustedFiles": "newWindow", // Abre arquivos não confiáveis em nova janela
  "update.mode": "default",
  "update.showReleaseNotes": false,

  // 🚫 --- ARQUIVOS IGNORADOS ---
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/.hg": true,
    "**/.svn": true,
    ".vscode": true
  },

  // 🌍 --- OUTROS ---
  "cSpell.language": "en,pt", // Idiomas do corretor ortográfico
  "snyk.advanced.cliPath": "/Users/gabriellmatias/Library/Application Support/snyk/vscode-cli/snyk-macos-arm64",
  "snyk.folderConfigs": [
    {
      "folderPath": "/Users/gabriellmatias/Desktop/tus-project",
      "baseBranch": "",
      "preferredOrg": "",
      "autoDeterminedOrg": "",
      "orgMigratedFromGlobalConfig": false,
      "orgSetByUser": true,
      "featureFlags": {
        "internal_iaw_enabled": false,
        "snykCodeConsistentIgnores": false,
        "snykCodeInlineIgnore": false
      },
      "sastSettings": null
    }
  ],
  "snyk.trustedFolders": ["/Users/gabriellmatias/Desktop/parc-app-front"],
  "snyk.securityAtInception.autoConfigureSnykMcpServer": false,
  "snyk.securityAtInception.executionFrequency": "Manual",
  "snyk.yesWelcomeNotification": false,
  "snyk.scanningMode": "manual",
  "github.copilot.nextEditSuggestions.enabled": true,
  "explorer.confirmPasteNative": false,

  // 🛡️ --- PROTEÇÕES CONTRA PROBLEMAS ---
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.hg/store/**": true
  },
  "files.hotExit": "onExitAndWindowClose",
  "files.useExperimentalFileWatcher": false,
  "workbench.editor.autoLockGroups": {
    "default": false
  },
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "sonarlint.analysisExcludesStandalone": "**/.pytest_cache/**",
  "sonarlint.focusOnNewCode": false,
  "chat.editing.confirmEditRequestRemoval": false,
  "security.promptForLocalFileProtocolHandling": false,
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "chat.viewSessions.orientation": "stacked",
  "workbench.browser.openLocalhostLinks": false
}
